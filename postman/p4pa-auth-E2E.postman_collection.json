									"    pm.expect(jsonResponse).have.property(\"name\").to.eq(clientName)\r",
									"    pm.expect(jsonResponse).have.property(\"familyName\").to.eq(orgIpaCode)\r",
									"    pm.expect(jsonResponse).have.property(\"fiscalCode\").to.eq(orgIpaCode)\r",
									"    pm.expect(jsonResponse).have.property(\"issuer\").to.eq(orgIpaCode)\r",
									"    pm.expect(jsonResponse).to.have.property(\"brokerId\").that.is.a(\"number\");\r",
									"    pm.expect(jsonResponse).to.have.property(\"brokerFiscalCode\").that.is.a(\"string\");\r",
									"    pm.expect(jsonResponse).have.property(\"systemUser\").eq(true);\r",
									"\r",
									"    pm.expect(jsonResponse.organizations).have.property(\"length\").eq(1)\r",
									"    const org = jsonResponse.organizations[0]\r",
									"    pm.expect(org).have.property(\"organizationId\").that.is.a(\"number\");\r",
									"    pm.expect(org).have.property(\"organizationIpaCode\").eq(orgIpaCode)\r",
									"    pm.expect(org.roles).have.property(\"length\").to.eq(1)\r",
									"    pm.expect(org.roles[0]).to.eq(\"ROLE_ADMIN\")\r",
									"\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
